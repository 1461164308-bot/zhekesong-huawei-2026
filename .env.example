# Example names only. Load into the process environment; the app does not auto-read .env.
IMA_OPENAPI_CLIENTID=YOUR_CLIENT_ID
IMA_OPENAPI_APIKEY=YOUR_IMA_KEY
IMA_KB_NAME=任德耀新建华为PC知识库
IMA_SOURCE_MODE=live
LLM_BASE_URL=https://YOUR_OPENAI_COMPATIBLE_SERVICE/v1
LLM_API_KEY=YOUR_LLM_KEY
LLM_MODEL=YOUR_MODEL_ID
LLM_MAX_DAILY_CALLS=240
GRADIO_ANALYTICS_ENABLED=False

# Explicit, authorized archive mode (choose local path OR private remote source).
# IMA_SOURCE_MODE=archive
# IMA_ARCHIVE_PATH=/absolute/path/to/authorized.zip
# IMA_ARCHIVE_URL=https://modelscope.cn/api/v1/datasets/OWNER/PRIVATE_REPO/repo?Revision=master&FilePath=authorized.zip
# IMA_ARCHIVE_SHA256=YOUR_ARCHIVE_SHA256
# IMA_ARCHIVE_TOKEN=YOUR_PRIVATE_READ_TOKEN
